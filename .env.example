# ---- Gateway ----------------------------------------------------------------
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# x402. Testnet by default. For mainnet: X402_NETWORK=eip155:8453 and FACILITATOR=cdp.
X402_NETWORK=eip155:84532
# Receiving address. Production: a Safe multisig on Base (receive-only, no hot key).
PAY_TO=0x0000000000000000000000000000000000000000
FACILITATOR=x402org            # x402org (testnet only) | cdp | url
# FACILITATOR_URL=
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# FACILITATOR_AUTH_TOKEN=      # bearer for a self-hosted facilitator (FACILITATOR=url); required in production
# FALLBACK_FACILITATOR_URL=    # self-hosted facilitator (apps/facilitator) used when the primary breaker is open
# FALLBACK_FACILITATOR_AUTH_TOKEN=  # its AUTH_TOKEN; required in production with a fallback
SETTLEMENT_MODE=async          # async (verify-then-serve, exposure-capped) | sync
EXPOSURE_CAP_USD=25            # global, across all replicas (enforced in Postgres)
EXPOSURE_CAP_PER_PAYER_USD=1   # per payer, across all replicas
# BASE_RPC_URL=                # enables on-chain reconciliation of indeterminate settlements

# Data: simulator (in-process, labelled "simulated") or nats (from apps/ingest)
DATA_SOURCE=simulator
NATS_URL=nats://localhost:4222

# ERC-8004 buyer tiers (loosen-only). Needs BASE_RPC_URL. Registries default to the canonical ones.
# ERC8004_ENABLED=false
# ERC8004_TRUSTED_REVIEWERS=0x...,0x...      # whose feedback counts; empty: nobody is "trusted"
# ERC8004_REPUTATION_TAG=                     # optional tag1 filter, e.g. quality
# ERC8004_TRUSTED_MIN_FEEDBACK=3
# ERC8004_TRUSTED_MIN_SCORE=80
# EXPOSURE_CAP_PER_PAYER_IDENTIFIED_USD=2
# EXPOSURE_CAP_PER_PAYER_TRUSTED_USD=5
# SELLER_AGENT_ID=                            # our own ERC-8004 agent id, advertised to buyers

# FX_PROVIDER=coinbase         # coinbase (spot) | fixed (FX_FALLBACK_USDC_GBP; tests only, refused in production)

# Grid carbon product (NESO country forecast, NESO Open Data Licence)
# GRID_ENABLED=false
# GRID_SOURCE_URL=https://api.neso.energy
# GRID_POLL_MS=600000

# ingest-env: every published NESO version, for point-in-time history (uses DATABASE_URL)
# NESO_BASE_URL=https://api.neso.energy
# ENV_CHECK_INTERVAL_MS=30000        # metadata check; floor 5000
# ENV_MAX_FETCH_INTERVAL_MS=600000   # read the records at least this often
# ENV_MAX_BACKOFF_MS=300000
# ENV_HTTP_TIMEOUT_MS=10000
# ENV_HEALTH_PORT=8091

# Unset => in-memory store (dev only). Required in production.
# DATABASE_URL=postgres://mx:mx@localhost:5432/mx

# Fiat credits (Stripe Checkout, GBP). Unset => bank-transfer top-ups only.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Ops
ADMIN_TOKEN=change-me-to-a-long-random-string-0000
FX_FALLBACK_USDC_GBP=0.75
# SANCTIONS_DENYLIST_PATH=./data/sanctioned-addresses.txt
# CHAINALYSIS_API_KEY=
SANCTIONS_FAIL_CLOSED=false

# ---- Ingest -----------------------------------------------------------------
INGEST_SOURCES=simulator       # comma list: simulator,udp,tcp,aisstream
UDP_PORT=10110                 # AIS-catcher: -u <gateway-wg-ip> 10110
RECEIVER_ID=rx-kent-01
# AISSTREAM_API_KEY=

