{
  "name": "@mx/gas-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keeps the self-hosted facilitator's gas wallet funded: swaps USDC from a bounded float wallet to ETH on Uniswap v3 and tops the facilitator up.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:fork": "vitest run --config vitest.fork.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@mx/shared": "workspace:*",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "viem": "2.57.10",
    "zod": "3.25.76"
  }
}
