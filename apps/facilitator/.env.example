# Self-hosted x402 facilitator. Own env file: it must not inherit the gateway's PORT or secrets.
# cp apps/facilitator/.env.example apps/facilitator/.env
PORT=8090
LOG_LEVEL=info
NETWORK=eip155:84532
RPC_URL=https://sepolia.base.org
FACILITATOR_PRIVATE_KEY=0x...      # gas-only hot wallet; holds no customer funds. Keep ETH topped up.
# AUTH_TOKEN=                      # >= 24 chars; required in production; give it to the gateway
ALLOWED_PAY_TO=0x...               # comma-separated payTo addresses this facilitator will settle to
MIN_GAS_BALANCE_WEI=1000000000000000   # /readyz fails below this (0.001 ETH)
